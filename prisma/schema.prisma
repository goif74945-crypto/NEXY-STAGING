generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditEvent {
  id               String @id
  actorId          String
  action           String
  targetId         String
  createdAtEpochMs BigInt
}

model SessionRecord {
  id               String  @id
  userId           String
  email            String
  role             String
  deviceId         String
  issuedAtEpochMs  BigInt
  expiresAtEpochMs BigInt
  revokedAtEpochMs BigInt?
}

model RunRecord {
  id               String @id
  directiveId      String
  status           String
  outputClass      String
  startedAtEpochMs BigInt
  updatedAtEpochMs BigInt
  freezeReason     String
}
